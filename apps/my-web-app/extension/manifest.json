{
  "manifest_version": 3,
  "name": "ChatGPT Token Estimator",
  "version": "0.1.0",
  "description": "Estimates tokens and shows GPU usage dataset stats.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/gpu_usage.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
