{
  "manifest_version": 3,
  "name": "ChatGPT Sustainability Tracker",
  "version": "0.2.0",
  "description": "Tracks ChatGPT message energy usage per conversation with Keycloak authentication.",
  "permissions": ["storage", "identity", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/gpu_usage.json", "data/datagen_output.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
