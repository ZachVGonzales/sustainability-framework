# ──────────────────────────────────────────────────────────────────────────────
# Sustainability Framework – Environment Variables
# Copy / rename this file to .env and fill in your values.
# NEVER commit the real .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default – good for local dev)
DB_URL=sqlite:///./sustainability.db

# PostgreSQL example (uncomment and fill in for production):
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/sustainability

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sustainability
KEYCLOAK_CLIENT_ID=sustainability-extension

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Estimated energy per token in Wh (used to calculate message energy cost)
# ENERGY_PER_TOKEN_WH=0.001   # no longer used – ML model is used instead

# Path to the trained ML model (relative to repo root or absolute)
# Defaults to apps/ml-training/models/model.joblib
# MODEL_PATH=/absolute/path/to/model.joblib
